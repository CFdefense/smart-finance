# Postgres connection string used by the Rust server and the ai-service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_finance
# Credentials and database name that docker-compose gives the Postgres container.
# Keep them in step with DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_finance
FRONTEND_URL=http://localhost
BIND_ADDRESS=localhost:3001
RUST_LOG=debug
# Plaid API credentials from the Plaid dashboard.
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret
# Which Plaid environment to use: sandbox or production.
PLAID_ENV=sandbox
# Name Plaid shows to the user when they link a bank account.
PLAID_CLIENT_NAME='Smart Finance'
# 64-byte key, in hex, that signs the login cookie. The ai-service uses the same key to act as
# the signed-in user when they confirm a change. Anyone with it can sign in as any user, so
# generate a new one for every real deployment and keep it secret.
COOKIE_KEY=e8d52df0e840bfd3f1b86fb437a24cbba88a7ca88a3755449edb2b256af2b7932ef92d9ffa3c565d3c78c855448d9da03e6a27d9eb542199abb489eb56f01607
# OpenAI key the ai-service uses for the chat and analyzer models.
OPENAI_API_KEY=your_openai_api_key
# Small model that checks every chat message is about personal finance before the chat agent sees it.
# Optional; defaults to gpt-4.1-mini. If this check fails the chat refuses to answer.
SCOPE_MODEL=gpt-4.1-mini
# Where the Rust server reaches the ai-service. Defaults to http://127.0.0.1:8000 if unset.
AI_SERVICE_URL=http://127.0.0.1:8000
# How far from a user's usual spending a purchase must be before it is flagged as unusual.
ANOMALY_ZSCORE_THRESHOLD=3.5
# Email account the ai-service sends alert emails (and SMS through an email gateway) from.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
# For Gmail this is an app password, not the account password.
SMTP_PASSWORD=your_app_password
# Address the alerts appear to come from.
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
# Tavily key for the chat agent's web search. Without it chat still works but search fails.
TAVILY_API_KEY=your_tavily_api_key
