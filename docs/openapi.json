{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Finance API",
    "description": "The public API documentation for the Smart Finance web application.",
    "contact": {
      "name": "Smart Finance Contributors"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/user/login": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Authenticate a user",
        "description": "Verifies the password against the stored Argon2 hash and sets the `auth-token` cookie.\n\n`POST /api/user/login`",
        "operationId": "api_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "alice@example.com",
                "password": "Secret_123"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login successful, cookie set"
          },
          "400": {
            "description": "Invalid credentials"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/user/logout": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Log out the current user",
        "description": "Sets the `auth-token` cookie to expired, invalidating the session.\n\n`POST /api/user/logout`",
        "operationId": "api_logout",
        "responses": {
          "200": {
            "description": "Logged out, cookie expired"
          },
          "401": {
            "description": "Not authenticated"
          }
        },
        "security": [
          {
            "auth-token": []
          }
        ]
      }
    },
    "/api/user/signup": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Create a new user account",
        "description": "Validates the payload, checks email uniqueness, hashes the password with Argon2,\ninserts the user, and sets the `auth-token` cookie on success.\n\n`POST /api/user/signup`",
        "operationId": "api_signup",
        "requestBody": {
          "description": "Email must be unique. Password is validated server-side.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              },
              "example": {
                "email": "alice@example.com",
                "password": "Secret_123"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Account created and cookie set"
          },
          "400": {
            "description": "Validation failure"
          },
          "409": {
            "description": "Email already in use"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "description": "Request payload for `POST /api/user/login`.",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "Account email address."
          },
          "password": {
            "type": "string",
            "description": "Plaintext password submitted by the user."
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "description": "Request payload for `POST /api/user/signup`.\n\nValidated server-side via [`SignupRequest::validate`] before insert.",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "Account email address."
          },
          "password": {
            "type": "string",
            "description": "Plaintext password submitted by the user."
          }
        }
      }
    },
    "securitySchemes": {
      "auth-token": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auth-token",
        "description": "An HTTP-only private cookie encoding user id and expiry."
      }
    }
  },
  "security": [
    {},
    {
      "auth-token": []
    }
  ],
  "tags": [
    {
      "name": "User"
    }
  ]
}