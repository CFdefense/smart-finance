FROM rust:latest

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Install CI tools (same versions as workflow)
RUN cargo install sqlx-cli --no-default-features --features postgres --locked && \
    cargo install cargo-tarpaulin --locked

WORKDIR /app

# Default command mirrors the ci job steps in .github/workflows/ci.yml
CMD sqlx migrate run && \
    cargo fmt --check && \
    cargo clippy -- -D warnings && \
    cargo build --locked && \
    cargo tarpaulin --run-types Tests --fail-under 90 --out Stdout && \
    cargo tarpaulin --run-types Bins --fail-under 75 --out Stdout Html --output-dir docs/coverage && \
    cargo run --bin gen-openapi && \
    echo "✓ All CI checks passed."
