FROM rust:latest

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev curl && \
    rm -rf /var/lib/apt/lists/*

# sqlx-cli — prebuilt binary from GitHub releases
RUN curl -L --proto '=https' --tlsv1.2 -sSf \
    https://github.com/launchbadge/sqlx/releases/latest/download/sqlx-x86_64-unknown-linux-musl.tar.gz \
    | tar -xz -C /usr/local/bin sqlx

# cargo-tarpaulin — prebuilt binary from GitHub releases
RUN curl -L --proto '=https' --tlsv1.2 -sSf \
    https://github.com/xd009642/tarpaulin/releases/latest/download/cargo-tarpaulin-x86_64-unknown-linux-musl.tar.gz \
    | tar -xz -C /usr/local/bin cargo-tarpaulin

WORKDIR /app

# Default command mirrors the ci job steps in .github/workflows/ci.yml
CMD sqlx migrate run && \
    cargo fmt --check && \
    cargo clippy -- -D warnings && \
    cargo build --locked && \
    cargo tarpaulin --run-types Tests --fail-under 90 --out Stdout && \
    cargo tarpaulin --run-types Bins --fail-under 75 --out Stdout Html --output-dir docs/coverage && \
    cargo run --bin gen-openapi && \
    echo "✓ All CI checks passed."
